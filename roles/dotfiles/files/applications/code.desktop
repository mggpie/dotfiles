[Desktop Entry]
Name=Visual Studio Code
Comment=Code Editing. Redefined.
GenericName=Text Editor
Exec=env GDK_SCALE=1.0 GDK_DPI_SCALE=1.0 /usr/bin/code --unity-launch %F
Icon=vscode
Type=Application
StartupNotify=false
StartupWMClass=Code
Categories=Development;IDE;
MimeType=text/plain;inode/directory;
Actions=new-empty-window;
Keywords=vscode;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=env GDK_SCALE=1.0 GDK_DPI_SCALE=1.0 /usr/bin/code --new-window %F
Icon=vscode
