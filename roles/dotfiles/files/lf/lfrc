# lf configuration

# === Appearance ===
set icons true
set drawbox true
set borderfmt "\033[90m"
set cursorpreviewfmt "\033[7m"
set promptfmt "\033[34;1m%d\033[0m\033[33;1m%f\033[0m"
set statfmt "\033[32m%p\033[0m| %c| %u| %g| %S| %t"
set timefmt "2006-01-02 15:04"
set errorfmt "\033[31;1m"
set infofmt "\033[33m"

# === Behavior ===
set hidden true
set ignorecase true
set smartcase true
set anchorfind true
set findlen 1
set incsearch true
set incfilter true
set scrolloff 5
set tabstop 4
set wrapscroll true
set cleaner ~/.config/lf/clean
set previewer ~/.config/lf/preview
set shell fish
set shellopts '-c'
set ifs "\n"
set filesep "\n"
set info size:time
set dircounts true
set period 1
set autoquit true

# === Sorting ===
set sortby natural
set dirfirst true
set reverse false

# === Ratios (3 columns) ===
set ratios 1:2:3

# === Key bindings ===
# Navigation
map <enter> open
map o open
map . set hidden!
map <esc> quit
map Q quit
map R reload
map C clear

# File operations
map D delete
map dd cut
map yy copy
map pp paste
map yn $echo -n "$f" | wl-copy
map yp $echo -n "$f" | sed 's/\/[^\/]*$//' | wl-copy

# Create/rename
map a push %touch<space>
map A push %mkdir<space>
map r rename
map I :rename; cmd-home
map i :rename; cmd-end; cmd-delete-home
map cw push :rename<space>

# Bulk rename
map br ${{
    old="$(mktemp)"
    new="$(mktemp)"
    [ -n "$fs" ] && fs="$(basename -a -- $fs)" || fs="$(ls)"
    printf '%s\n' "$fs" > "$old"
    printf '%s\n' "$fs" > "$new"
    $EDITOR "$new"
    [ "$(wc -l < "$new")" -ne "$(wc -l < "$old")" ] && exit
    paste "$old" "$new" | while IFS=$(printf "\t") read -r src dst; do
        [ "$src" = "$dst" ] || [ -e "$dst" ] || mv -- "$src" "$dst"
    done
    rm -- "$old" "$new"
    lf -remote "send $id unselect"
}}

# Search/filter
map f filter
map F setfilter
map / search
map n search-next
map N search-prev

# Quick navigation
map gd cd ~/0-Inbox
map gD cd ~/3-Resources
map gp cd ~/3-Resources/pics
map gv cd ~/3-Resources/videos
map gm cd ~/3-Resources/music
map gc cd ~/.config
map gl cd ~/.local
map gn cd ~/me
map gt cd /tmp
map g/ cd /

# Selection
map <space> :toggle; down
map v invert
map u unselect
map V invert-below

# Archive operations
map az ${{
    set -f
    name=$(basename "$f")
    printf "Archive name: "
    read ans
    zip -r "$ans.zip" "$name"
}}

map at ${{
    set -f
    name=$(basename "$f")
    printf "Archive name: "
    read ans
    tar -czvf "$ans.tar.gz" "$name"
}}

map ax ${{
    set -f
    case "$f" in
        *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf "$f";;
        *.tar.gz|*.tgz) tar xzvf "$f";;
        *.tar.xz|*.txz) tar xJvf "$f";;
        *.tar) tar xvf "$f";;
        *.zip) unzip "$f";;
        *.rar) unrar x "$f";;
        *.7z) 7z x "$f";;
        *) echo "Unknown archive format";;
    esac
}}

# Chmod
map ch ${{
    printf "Mode: "
    read ans
    chmod "$ans" $fx
    lf -remote "send $id reload"
}}

# Dragon drag-and-drop (if installed)
map dr $dragon-drop -a -x $fx

# FZF integration
map <c-f> $lf -remote "send $id select \"$(fzf)\""

# Open with
map O $mimeopen --ask "$f"

# Terminal here
map w $foot

# === Commands ===
cmd open ${{
    case $(file --mime-type "$f" -bL) in
        text/*|application/json|application/javascript|application/xml|inode/x-empty)
            $EDITOR "$f";;
        video/*|audio/*)
            mpv "$f";;
        image/*)
            imv "$f";;
        application/pdf|application/epub+zip)
            zathura "$f";;
        application/x-bittorrent)
            qbittorrent "$f";;
        application/zip|application/x-tar|application/gzip|application/x-rar|application/x-7z-compressed)
            echo "Archive: $f"
            echo "Press 'ax' to extract";;
        *)
            xdg-open "$f" &>/dev/null &;;
    esac
}}

cmd delete ${{
    set -f
    printf "Delete $fx? [y/N] "
    read ans
    [ "$ans" = "y" ] && rm -rf $fx
}}

cmd mkdir ${{
    printf "Directory name: "
    read ans
    mkdir -p "$ans"
}}

cmd touch ${{
    printf "File name: "
    read ans
    touch "$ans"
}}

# Trash support (if trash-cli installed)
cmd trash ${{
    files=$(printf "$fx" | tr '\n' ';')
    while [ "$files" ]; do
        file=${files%%;*}
        trash-put "$(basename "$file")"
        if [ "$files" = "$file" ]; then
            files=''
        else
            files="${files#*;}"
        fi
    done
}}
map <delete> trash

# On cd - update terminal title
cmd on-cd &{{
    printf "\033]0; $(pwd | sed "s|$HOME|~|")\007" > /dev/tty
}}
on-cd

