[user]
    name = mggpie
    email = mggpie@users.noreply.github.com

[init]
    defaultBranch = main

[core]
    editor = micro
    pager = bat --style=plain

[pull]
    rebase = true

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate
    unstage = reset HEAD --
    last = log -1 HEAD
    amend = commit --amend --no-edit
    a = add
    aa = add --all
    ap = add --patch
    d = diff
    ds = diff --staged
    dt = difftool
    p = pull
    pr = pull --rebase
    ps = push
    pf = push --force-with-lease
    rb = rebase
    rbi = rebase -i
    sw = switch
    swc = switch -c
    l = log --oneline --graph
    ll = log --graph --pretty=format:'%C(yellow)%h%Creset%C(auto)%d%Creset %s %C(green)(%cr)%Creset %C(bold blue)<%an>%Creset'
    undo = reset --soft HEAD^
