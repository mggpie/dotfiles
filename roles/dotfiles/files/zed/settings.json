{
    // Assistant (Copilot) settings
    "assistant": {
        "version": "2",
        "default_model": {
            "provider": "anthropic",
            "model": "claude-sonnet-4-5-20250514",
        },
    },

    // UI settings
    "theme": "One Dark",
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_size": 14,
    "ui_font_size": 16,
    "tab_size": 2,
    "soft_wrap": "editor_width",
    "show_whitespaces": "selection",
    "relative_line_numbers": true,
    "cursor_blink": false,

    // Editor behavior
    "autosave": "on_focus_change",
    "format_on_save": "on",
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "tab_bar": {
        "show": true,
    },

    // Terminal
    "terminal": {
        "shell": {
            "program": "fish",
        },
        "font_family": "JetBrainsMono Nerd Font",
        "font_size": 14,
    },

    // File tree
    "project_panel": {
        "dock": "left",
        "default_width": 240,
    },

    // Git
    "git": {
        "git_gutter": "tracked_files",
        "inline_blame": {
            "enabled": true,
        },
    },

    // LSP and language specific
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "check": {
                    "command": "clippy",
                },
            },
        },
    },

    // Telemetry
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
}
