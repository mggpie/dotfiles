{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "custom/weather", "battery"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "clock": {
        "format": "{:%a, %d %b  %H:%M}",
        "tooltip-format": "{:%Y-%m-%d}"
    },
    "battery": {
        "format": "<span size='x-large'>{icon}</span>  <span rise='2000'>{capacity}%</span>",
        "format-charging": "<span size='x-large'>󰂄</span>  <span rise='2000'>{capacity}%</span>",
        "format-plugged": "<span size='x-large'></span>  <span rise='2000'>{capacity}%</span>",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "custom/weather": {
        "exec": "curl -s 'wttr.in/Warsaw?format=%t' | tr -d '+'",
        "interval": 600,
        "format": "<span size='x-large'>󰔏</span>  <span rise='2000'>{}</span>",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "<span size='x-large'>{icon}</span>  <span rise='2000'>{volume}%</span>",
        "format-muted": "<span size='x-large'>󰝟</span>",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "swaymsg exec pavucontrol"
    }
}
