{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,
    "modules-left": ["sway/workspaces"],
    "modules-center": ["custom/calendar"],
    "modules-right": ["custom/radio-prev", "custom/radio-next", "custom/radio-toggle", "pulseaudio", "custom/weather", "battery"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "custom/calendar": {
        "exec": "fish -c calendar",
        "return-type": "json",
        "interval": 30
    },
    "battery": {
        "format": "<span size='x-large'>{icon}</span>  <span rise='2000'>{capacity}%</span>",
        "format-charging": "<span size='x-large'>󰂄</span>  <span rise='2000'>{capacity}%</span>",
        "format-plugged": "<span size='x-large'></span>  <span rise='2000'>{capacity}%</span>",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "custom/weather": {
        "exec": "fish -c weather",
        "return-type": "json",
        "interval": 600,
        "format": "{}"
    },
    "custom/radio-prev": {
        "format": "<span size='x-large'>󰒮</span>",
        "on-click": "fish -c 'radio prev'",
        "tooltip": false
    },
    "custom/radio-toggle": {
        "exec": "fish -c 'radio status'",
        "return-type": "json",
        "interval": 3,
        "on-click": "fish -c 'radio toggle'"
    },
    "custom/radio-next": {
        "format": "<span size='x-large'>󰒭</span>",
        "on-click": "fish -c 'radio next'",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "<span size='x-large'>{icon}</span>  <span rise='2000'>{volume}%</span>",
        "format-muted": "<span size='x-large'>󰝟</span>",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "swaymsg exec pavucontrol"
    }
}
