#!/bin/sh
# Scans PARA directories for GitHub repos and updates vars/main.yml to match.
# Runs daily via cron. Auto-commits and pushes dotfiles if changed.

DOTFILES="{{ user_home }}/Desktop/1-Projects/dotfiles"
VARS_FILE="$DOTFILES/roles/dotfiles/vars/main.yml"
PARA_BASE="{{ user_home }}/Desktop"

# Get list of repos from GitHub
repos=$(gh repo list --json name --limit 100 --no-archived -q '.[].name' 2>/dev/null)
[ -z "$repos" ] && exit 0

# Scan 1-Projects and 2-Areas for repos that are "active"
active=""
for repo in $repos; do
    for dir in 1-Projects 2-Areas; do
        if [ -d "$PARA_BASE/$dir/$repo/.git" ]; then
            active="$active  - $repo
"
            break
        fi
    done
done

# If nothing found active, keep at least dotfiles
if [ -z "$active" ]; then
    active="  - dotfiles
"
fi

# Build the new repos_active block
new_block="repos_active:
$active"

# Remove trailing newline from block for clean sed
new_block=$(printf '%s' "$new_block")

# Update vars/main.yml - replace repos_active section
# Use awk to replace the block between "repos_active:" and the next non-list line (or EOF)
awk -v new="$new_block" '
    /^repos_active:/ { found=1; print new; next }
    found && /^  - / { next }
    found && !/^  - / { found=0 }
    { print }
' "$VARS_FILE" > "$VARS_FILE.tmp" && mv "$VARS_FILE.tmp" "$VARS_FILE"

# Check if anything changed in dotfiles
cd "$DOTFILES" || exit 0
if ! git diff --quiet -- roles/dotfiles/vars/main.yml; then
    git add roles/dotfiles/vars/main.yml
    git commit -m "auto: repos-sync updated PARA destinations"
    git push
fi
